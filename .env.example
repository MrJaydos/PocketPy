# Copy this file to `.env` and fill in real values for local development.
# In Coolify, set these as environment variables on the service instead.

# Port the single Node process listens on (serves both the API and the built SPA).
PORT=3000

# The one password that gates the whole app. Choose something long.
APP_PASSWORD=change-me-to-a-long-passphrase

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-32-plus-random-bytes-hex

# Where the SQLite file lives. In Docker/Coolify this is a mounted volume.
# Locally it defaults to ./data/app.db if unset.
DB_PATH=./data/app.db

# IANA timezone used to decide which calendar day a solve counts towards
# (drives the daily streak). Example: Europe/London, America/New_York.
APP_TZ=UTC

# NODE_ENV controls cookie "Secure" flag and error verbosity.
# Use "production" behind the Cloudflare tunnel (HTTPS), "development" locally.
NODE_ENV=development
